PROJECT_NAME="AICTE Document Verification System"
API_V1_STR="/api/v1"
SECRET_KEY="aicte-super-secure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM="HS256"

# Database
DATABASE_URL="sqlite:///./aicte_verifier.db"

# Storage
STORAGE_DIR="./storage"
DERIVED_DIR="./storage/derived"
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=20

# OCR & Processing
TESSERACT_CMD="" # Empty to auto-detect from PATH, or e.g. "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
OCR_LANG="eng"
LLM_EXTRACTION_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
